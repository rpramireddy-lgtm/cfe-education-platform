# ============================================================
# CFE Education Platform — Environment Variables Reference
# Copy to frontend/.env.local for local development
# NEVER commit real values to source control
# ============================================================

# --- Amplify / AWS (auto-generated by `ampx sandbox`, do not set manually) ---
# amplify_outputs.json is generated at runtime — do not set these manually

# --- Next.js ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=local

# --- Stripe (public key only — safe for browser) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_<your_stripe_publishable_key>

# --- Stripe (private — Lambda/server only, stored in SSM in deployed envs) ---
# STRIPE_SECRET_KEY → SSM: /cfe-education/<env>/stripe/secret-key
# STRIPE_WEBHOOK_SECRET → SSM: /cfe-education/<env>/stripe/webhook-secret

# --- WhatsApp / End User Messaging Social (Lambda only, stored in SSM) ---
# WHATSAPP_PHONE_NUMBER_ID → SSM: /cfe-education/<env>/whatsapp/phone-number-id
# WHATSAPP_ACCESS_TOKEN    → SSM: /cfe-education/<env>/whatsapp/access-token

# --- Amazon Polly ---
# POLLY_VOICE_ID → SSM: /cfe-education/<env>/polly/voice-id  (default: Amy)

# --- Amazon Bedrock ---
# BEDROCK_GENERATION_MODEL_ID  → SSM: /cfe-education/<env>/bedrock/generation-model-id
# BEDROCK_EMBEDDING_MODEL_ID   → SSM: /cfe-education/<env>/bedrock/embedding-model-id

# --- AWS Region (used by CDK custom constructs) ---
CDK_DEFAULT_REGION=eu-west-2
# CDK_DEFAULT_ACCOUNT is resolved from the active AWS profile at deploy time
